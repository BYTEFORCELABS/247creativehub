---
import '@fontsource-variable/urbanist/wght.css';
import '@fontsource-variable/figtree/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import urbanistWoff2 from '@fontsource-variable/urbanist/files/urbanist-latin-wght-normal.woff2?url';
import figtreeWoff2 from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  variant?: 'consultancy' | 'creative';
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | null;
}

const {
  title,
  description,
  variant = 'consultancy',
  ogImage = '/og-image.png',
  noindex = false,
  jsonLd = null,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
const themeColor = '#031a48';
---

<!doctype html>
<html lang="en-GB" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={themeColor} />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={urbanistWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={figtreeWoff2} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="247CREATIVEHUB" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
  </head>
  <body class:list={[`theme-${variant}`]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header variant={variant} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style is:global>
  #main:focus {
    outline: none;
  }
</style>
