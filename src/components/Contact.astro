---
import Icon from './Icon.astro';
import { contact, links, services } from '../data/site';

// If PUBLIC_FORM_ENDPOINT is set at build time, enquiries are POSTed there (e.g. Formspree).
// Otherwise the form opens the visitor's email app with the enquiry pre-filled. Nothing is faked.
const endpoint = (import.meta.env.PUBLIC_FORM_ENDPOINT || '').trim();
const mode = endpoint ? 'endpoint' : 'mailto';
---

<section class="section contact on-dark" id="contact" aria-labelledby="contact-title">
  <div class="contact__bg" aria-hidden="true"></div>
  <div class="container contact__grid">
    <div class="contact__intro">
      <p class="eyebrow" data-reveal>Get in touch</p>
      <h2 id="contact-title" data-reveal style="--d:1">
        What is your supply chain <span class="accent">costing you?</span>
      </h2>
      <p class="contact__lede" data-reveal style="--d:2">
        If supplier delays, rising costs, excess stock or limited visibility are holding your business back, let’s
        identify the most useful first step.
      </p>

      <ul role="list" class="channels" data-reveal style="--d:3">
        <li>
          <a href={links.mailto()} class="channel">
            <span class="channel__icon"><Icon name="mail" size={20} /></span>
            <span>
              <small>Email</small>
              <strong>{contact.email}</strong>
            </span>
            <Icon name="arrow-up-right" size={18} class="channel__go" />
          </a>
        </li>
        <li>
          <a href={links.whatsapp()} class="channel" target="_blank" rel="noopener">
            <span class="channel__icon"><Icon name="whatsapp" size={20} /></span>
            <span>
              <small>WhatsApp</small>
              <strong>{contact.whatsappDisplay}</strong>
            </span>
            <Icon name="arrow-up-right" size={18} class="channel__go" />
          </a>
        </li>
        <li class="channel channel--static">
          <span class="channel__icon"><Icon name="map-pin" size={20} /></span>
          <span>
            <small>Location</small>
            <strong>{contact.location}, working across the UK</strong>
          </span>
        </li>
      </ul>

      <div class="next" data-reveal style="--d:4">
        <p class="fig-note">What happens next</p>
        <ol role="list">
          <li><span>1</span>We read your enquiry and reply by email or WhatsApp.</li>
          <li><span>2</span>A short call to understand what’s happening and what data you have.</li>
          <li><span>3</span>We suggest a first step that fits the size of the problem.</li>
        </ol>
      </div>
    </div>

    <div class="form-card" data-reveal style="--d:2">
      <form
        class="form"
        novalidate
        data-enquiry-form
        data-mode={mode}
        data-endpoint={endpoint || undefined}
        data-email={contact.email}
        data-whatsapp={contact.whatsappIntl}
        action={endpoint || `mailto:${contact.email}`}
        method="post"
        enctype={endpoint ? undefined : 'text/plain'}
        aria-labelledby="form-title"
      >
        <div class="form__head">
          <h3 id="form-title">Tell us what is happening in your business.</h3>
          <p>We’ll help clarify the problem, the evidence required and the most proportionate way forward.</p>
        </div>

        <div class="form__grid">
          <div class="field">
            <label for="f-name">Name</label>
            <input id="f-name" name="name" type="text" autocomplete="name" required minlength="2" maxlength="120" aria-describedby="f-name-err" />
            <p class="field__err" id="f-name-err" hidden></p>
          </div>
          <div class="field">
            <label for="f-email">Business email</label>
            <input id="f-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="200" aria-describedby="f-email-err" />
            <p class="field__err" id="f-email-err" hidden></p>
          </div>
          <div class="field">
            <label for="f-company">Company name <span class="field__opt">Optional</span></label>
            <input id="f-company" name="company" type="text" autocomplete="organization" maxlength="160" />
          </div>
          <div class="field">
            <label for="f-service">Area of support</label>
            <div class="select">
              <select id="f-service" name="service" required aria-describedby="f-service-err">
                <option value="" selected disabled>Select an area</option>
                {services.map((s) => <option value={s.id}>{s.title}</option>)}
                <option value="unsure">Not sure yet, I’d like advice</option>
              </select>
              <Icon name="chevron-down" size={18} />
            </div>
            <p class="field__err" id="f-service-err" hidden></p>
          </div>
          <div class="field field--full">
            <label for="f-message">What’s happening?</label>
            <textarea
              id="f-message"
              name="message"
              rows="5"
              required
              minlength="15"
              maxlength="2000"
              placeholder="For example: late deliveries from key suppliers, rising costs, too much stock, or reports nobody trusts."
              aria-describedby="f-message-err f-message-count"
            ></textarea>
            <div class="field__meta">
              <p class="field__err" id="f-message-err" hidden></p>
              <span class="field__count" id="f-message-count" aria-live="off"><span data-count>0</span> / 2000</span>
            </div>
          </div>
        </div>

        <div class="hp" aria-hidden="true">
          <label>Leave this field empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="form__foot">
          <button type="submit" class="btn btn--navy form__submit" data-submit>
            <span data-submit-label>{mode === 'endpoint' ? 'Send enquiry' : 'Prepare email'}</span>
            <Icon name="send" size={17} />
          </button>
          {
            mode === 'mailto' ? (
              <p class="form__hint">
                Opens your email app with your enquiry ready to send. Prefer WhatsApp?{' '}
                <button type="button" class="form__link" data-whatsapp-send>
                  Send it via WhatsApp
                </button>
              </p>
            ) : (
              <p class="form__hint">
                Prefer WhatsApp?{' '}
                <button type="button" class="form__link" data-whatsapp-send>
                  Send it via WhatsApp
                </button>
              </p>
            )
          }
        </div>
        <p class="form__privacy">
          We only use your details to respond to your enquiry. See our <a href="/privacy">privacy notice</a>.
        </p>

        <div class="form__status" role="status" aria-live="polite" data-status></div>
      </form>

      <div class="form__done" hidden tabindex="-1" data-done>
        <span class="form__done-icon"><Icon name="check" size={26} strokeWidth={2} /></span>
        <h3 data-done-title>Thank you.</h3>
        <p data-done-text></p>
        <div class="form__done-actions" data-done-actions></div>
        <button type="button" class="form__link" data-reset>Start a new enquiry</button>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--navy-950);
    overflow: clip;
  }
  .contact__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 55% 60% at 100% 0%, rgb(39 155 72 / 0.18), transparent 70%),
      radial-gradient(ellipse 60% 60% at 0% 100%, rgb(26 69 146 / 0.45), transparent 70%);
    pointer-events: none;
  }
  .contact__grid {
    position: relative;
    display: grid;
    gap: clamp(48px, 6vw, 80px);
  }
  @media (min-width: 1024px) {
    .contact__grid {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: start;
    }
  }
  .contact__intro h2 {
    margin-top: 1.25rem;
    font-size: var(--step-4);
  }
  .contact__intro h2 .accent {
    color: var(--yellow);
  }
  .contact__lede {
    margin-top: 1.5rem;
    color: var(--on-dark-2);
    font-size: var(--step-1);
    max-width: 44ch;
  }

  /* Channels */
  .channels {
    display: grid;
    gap: 0.6rem;
    margin-top: 2.5rem;
    max-width: 480px;
  }
  .channel {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--line-dark);
    background: rgb(255 255 255 / 0.03);
    transition:
      border-color 0.25s,
      background-color 0.25s;
  }
  a.channel:hover {
    border-color: var(--line-dark-strong);
    background: rgb(255 255 255 / 0.07);
  }
  .channel__icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.07);
    color: var(--green-300);
  }
  .channel small {
    display: block;
    font-size: 0.82rem;
    color: var(--on-dark-3);
  }
  .channel strong {
    display: block;
    margin-top: 0.1rem;
    font-weight: 560;
    overflow-wrap: anywhere;
  }
  @media (max-width: 400px) {
    .channel {
      gap: 0.75rem;
      padding: 0.8rem 0.85rem;
    }
    .channel__icon {
      width: 36px;
      height: 36px;
    }
    .channel strong {
      font-size: 0.95rem;
    }
    .channel :global(.channel__go) {
      display: none;
    }
  }
  .channel :global(.channel__go) {
    color: var(--on-dark-3);
    transition:
      transform 0.3s var(--ease-out),
      color 0.3s;
  }
  a.channel:hover :global(.channel__go) {
    color: var(--yellow);
    transform: translate(2px, -2px);
  }

  .next {
    margin-top: 2.5rem;
    max-width: 480px;
  }
  .next ol {
    display: grid;
    gap: 0.8rem;
    margin-top: 1rem;
  }
  .next li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    font-size: 0.95rem;
    color: var(--on-dark-2);
    line-height: 1.5;
  }
  .next li span {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    border: 1px solid var(--line-dark-strong);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--yellow);
  }

  /* Form card */
  .form-card {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.55);
  }
  /* The card is a light surface inside a dark section: restore light-surface tokens */
  .form-card :global(.btn--ghost) {
    --btn-fg: var(--ink);
    --btn-bd: var(--line-strong);
  }
  .form-card :global(.btn--ghost:hover) {
    --btn-bd: var(--ink);
    --btn-bg: transparent;
  }
  .form-card :global(:focus-visible) {
    outline-color: var(--green-600);
  }
  .form__head h3 {
    font-size: var(--step-2);
    letter-spacing: -0.03em;
    color: var(--navy-900);
  }
  .form__head p {
    margin-top: 0.6rem;
    color: var(--muted);
    font-size: 0.97rem;
  }
  .form__grid {
    display: grid;
    gap: 1.1rem;
    margin-top: 1.75rem;
  }
  @media (min-width: 600px) {
    .form__grid {
      grid-template-columns: 1fr 1fr;
    }
    .field--full {
      grid-column: 1 / -1;
    }
  }
  .field {
    display: grid;
    gap: 0.45rem;
    align-content: start;
  }
  .field label {
    display: flex;
    justify-content: space-between;
    font-size: 0.88rem;
    font-weight: 560;
    color: var(--ink-2);
  }
  .field__opt {
    font-weight: 400;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 50px;
    padding: 0.75rem 0.95rem;
    border-radius: 12px;
    border: 1px solid var(--line-strong);
    background: var(--cream);
    font-size: 1rem;
    color: var(--ink);
    transition:
      border-color 0.2s,
      box-shadow 0.2s,
      background-color 0.2s;
  }
  .field textarea {
    resize: vertical;
    min-height: 140px;
    line-height: 1.5;
  }
  .field textarea::placeholder {
    color: #8a94a3;
  }
  .field input:hover,
  .field select:hover,
  .field textarea:hover {
    border-color: #aeb8c6;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--navy-600);
    background: var(--paper);
    box-shadow: 0 0 0 4px rgb(26 69 146 / 0.14);
  }
  .field [aria-invalid='true'] {
    border-color: var(--status-bad);
    background: #fff7f7;
  }
  .field [aria-invalid='true']:focus {
    box-shadow: 0 0 0 4px rgb(196 60 60 / 0.14);
  }
  .select {
    position: relative;
  }
  .select select {
    appearance: none;
    padding-right: 2.5rem;
    cursor: pointer;
  }
  .select select:invalid {
    color: #6b7686;
  }
  .select :global(.icon) {
    position: absolute;
    right: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--muted);
  }
  .select.is-flash select {
    animation: flash 1.2s var(--ease-out);
  }
  @keyframes flash {
    0%,
    40% {
      border-color: var(--green-600);
      box-shadow: 0 0 0 4px rgb(39 155 72 / 0.2);
    }
  }
  .field__err {
    display: flex;
    gap: 0.35rem;
    font-size: 0.84rem;
    color: var(--status-bad);
  }
  .field__err::before {
    content: '!';
    display: grid;
    place-items: center;
    flex: none;
    width: 16px;
    height: 16px;
    margin-top: 0.15rem;
    border-radius: 999px;
    background: var(--status-bad);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
  }
  .field__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .field__count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--muted);
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
    margin-top: 1.75rem;
  }
  .form__submit {
    min-width: 180px;
  }
  .form__submit.is-loading :global(.icon) {
    animation: send 1s var(--ease-in-out) infinite;
  }
  @keyframes send {
    50% {
      transform: translate(3px, -3px);
      opacity: 0.4;
    }
  }
  .form__hint {
    flex: 1 1 220px;
    font-size: 0.86rem;
    color: var(--muted);
    line-height: 1.5;
  }
  .form__link {
    padding: 0;
    border: 0;
    background: none;
    font-weight: 560;
    color: var(--green-700);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .form__link:hover {
    color: var(--navy-800);
  }
  .form__privacy {
    margin-top: 1.25rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
    color: var(--muted);
  }
  .form__privacy a {
    color: var(--navy-800);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .form__status:not(:empty) {
    margin-top: 1rem;
    padding: 0.9rem 1rem;
    border-radius: 12px;
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .form__status[data-tone='error'] {
    background: #fdf1f1;
    color: #8f2626;
    border: 1px solid #f1caca;
  }
  .form__status[data-tone='info'] {
    background: var(--stone-50);
    color: var(--ink-2);
    border: 1px solid var(--line);
  }
  .form__status :global(a) {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Done state */
  .form__done {
    padding: 1rem 0;
    animation: open 0.5s var(--ease-out);
  }
  .form__done:focus {
    outline: none;
  }
  .form__done-icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 999px;
    background: var(--green-600);
    color: #fff;
  }
  .form__done h3 {
    margin-top: 1.5rem;
    font-size: var(--step-2);
    letter-spacing: -0.03em;
    color: var(--navy-900);
  }
  .form__done p {
    margin-top: 0.75rem;
    color: var(--muted);
    max-width: 52ch;
  }
  .form__done-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.5rem 0;
  }
  .form__done-actions:empty {
    margin: 1rem 0 0;
  }
  .form__done-actions :global(.btn) {
    min-height: 44px;
    font-size: 0.9rem;
  }
  @keyframes open {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
</style>
