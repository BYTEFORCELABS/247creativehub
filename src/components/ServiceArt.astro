---
/** Small bespoke illustration for each service (decorative). */
import type { ServiceId } from '../data/site';
interface Props {
  id: ServiceId;
}
const { id } = Astro.props;
---

<svg class="art" viewBox="0 0 240 120" aria-hidden="true" focusable="false">
  {
    id === 'spend' && (
      <g>
        {[78, 56, 40, 28, 20, 14].map((h, i) => (
          <rect x={30 + i * 30} y={104 - h} width="18" height={h} rx="3" class={i < 2 ? 'f-navy' : 'f-soft'} style={`--i:${i}`} data-bar />
        ))}
        <path d="M39 44 C 70 20, 100 14, 129 10 S 190 6, 199 5" class="s-green" fill="none" />
        {[[39, 44], [69, 24], [99, 15]].map(([x, y]) => (
          <circle cx={x} cy={y} r="4" class="f-green ring" />
        ))}
        <line x1="22" y1="104.5" x2="218" y2="104.5" class="s-line" />
      </g>
    )
  }
  {
    id === 'supplier' && (
      <g>
        {[5, 3, 4].map((score, r) => (
          <g transform={`translate(28 ${20 + r * 30})`}>
            <rect width="62" height="10" rx="5" y="2" class="f-soft" />
            {[0, 1, 2, 3, 4].map((d) => (
              <circle cx={88 + d * 17} cy="7" r="6" class={d < score ? (score >= 4 ? 'f-green' : 'f-yellow') : 'f-empty'} data-dot style={`--i:${r * 5 + d}`} />
            ))}
          </g>
        ))}
        <g transform="translate(200 18)">
          <rect width="24" height="24" rx="7" class="f-navy" />
          <path d="m7 12.5 3.5 3.5 6.5-7" class="s-white" fill="none" />
        </g>
      </g>
    )
  }
  {
    id === 'inventory' && (
      <g>
        {[
          [4, 3],
          [2, 2],
          [5, 3],
          [3, 3],
          [1, 1],
        ].map(([n, ok], c) =>
          Array.from({ length: n }).map((_, r) => (
            <rect x={34 + c * 36} y={86 - r * 19} width="26" height="16" rx="3" class={r < ok ? 'f-soft' : 'f-yellow'} data-box style={`--i:${c * 2 + r}`} />
          )),
        )}
        <line x1="24" y1="44" x2="216" y2="44" class="s-green" />
        <text x="216" y="38" text-anchor="end" class="t-label">TARGET LEVEL</text>
        <line x1="24" y1="104.5" x2="216" y2="104.5" class="s-line" />
      </g>
    )
  }
  {
    id === 'resilience' && (
      <g>
        <path d="M44 60 L120 26 L196 60" class="s-line" fill="none" stroke-dasharray="4 5" />
        <path d="M44 60 L120 94 L196 60" class="s-green" fill="none" data-route />
        <line x1="44" y1="60" x2="196" y2="60" class="s-soft" />
        <circle cx="120" cy="60" r="9" class="f-white s-soft" />
        <path d="m116 56 8 8m0-8-8 8" class="s-muted" />
        <circle cx="44" cy="60" r="12" class="f-navy" />
        <circle cx="196" cy="60" r="12" class="f-navy" />
        <circle cx="120" cy="26" r="8" class="f-soft" />
        <circle cx="120" cy="94" r="9" class="f-green" />
        <text x="120" y="117" text-anchor="middle" class="t-label">ALTERNATIVE ROUTE</text>
      </g>
    )
  }
  {
    id === 'tender' && (
      <g>
        <rect x="40" y="10" width="78" height="100" rx="6" class="f-white s-line" />
        {[26, 38, 50, 62].map((y, i) => (
          <rect x="52" y={y} width={i === 3 ? 34 : 54} height="5" rx="2.5" class="f-soft" />
        ))}
        <rect x="52" y="80" width="30" height="16" rx="4" class="f-navy" />
        {[0, 1, 2].map((r) => (
          <g transform={`translate(136 ${24 + r * 26})`}>
            <rect width="16" height="16" rx="4" class={r < 2 ? 'f-green' : 'f-empty'} data-check style={`--i:${r}`} />
            {r < 2 && <path d="m4 8.5 2.8 2.8L12 5.6" class="s-white" fill="none" />}
            <rect x="26" y="5" width={r === 1 ? 40 : 52} height="6" rx="3" class="f-soft" />
          </g>
        ))}
      </g>
    )
  }
  {
    id === 'reporting' && (
      <g>
        <rect x="18" y="12" width="128" height="96" rx="8" class="f-white s-line" />
        <polyline points="32,86 52,74 72,78 92,58 112,52 132,36" class="s-green" fill="none" data-line />
        <line x1="32" y1="96.5" x2="132" y2="96.5" class="s-line" />
        <text x="32" y="30" class="t-label">DELIVERY OTIF</text>
        <rect x="156" y="12" width="66" height="44" rx="8" class="f-navy" />
        <rect x="166" y="24" width="28" height="5" rx="2.5" class="f-soft-dark" />
        <rect x="166" y="36" width="40" height="9" rx="3" class="f-yellow" />
        <rect x="156" y="64" width="66" height="44" rx="8" class="f-white s-line" />
        {[16, 24, 12, 28].map((h, i) => (
          <rect x={168 + i * 12} y={98 - h} width="7" height={h} rx="2" class={i === 3 ? 'f-navy' : 'f-soft'} data-bar style={`--i:${i}`} />
        ))}
      </g>
    )
  }
</svg>

<style>
  .art {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .f-navy {
    fill: var(--navy-800);
  }
  .f-soft {
    fill: var(--navy-200);
  }
  .f-soft-dark {
    fill: rgb(255 255 255 / 0.35);
  }
  .f-green {
    fill: var(--green-600);
  }
  .f-yellow {
    fill: var(--yellow);
  }
  .f-white {
    fill: var(--paper);
  }
  .f-empty {
    fill: var(--stone-100);
    stroke: var(--line-strong);
  }
  .ring {
    stroke: var(--stone-50);
    stroke-width: 2;
  }
  .s-line {
    stroke: var(--line-strong);
    stroke-width: 1;
  }
  .s-soft {
    stroke: var(--navy-200);
    stroke-width: 1.5;
  }
  .s-muted {
    stroke: var(--muted);
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .s-green {
    stroke: var(--green-600);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .s-white {
    stroke: #fff;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .t-label {
    font-family: var(--font-mono);
    font-size: 7.5px;
    letter-spacing: 0.12em;
    fill: var(--muted);
  }

  /* Hover motion, driven by the parent card */
  [data-bar],
  [data-box] {
    transform-box: fill-box;
    transform-origin: bottom;
    transition: transform 0.6s var(--ease-out);
    transition-delay: calc(var(--i, 0) * 40ms);
  }
  :global(.svc:hover) [data-bar] {
    transform: scaleY(1.08);
  }
  :global(.svc:hover) [data-box] {
    transform: translateY(-3px);
  }
  [data-dot],
  [data-check] {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.4s var(--ease-out);
    transition-delay: calc(var(--i, 0) * 25ms);
  }
  :global(.svc:hover) [data-dot],
  :global(.svc:hover) [data-check] {
    transform: scale(1.12);
  }
  [data-route],
  [data-line] {
    stroke-dasharray: 260;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.2s var(--ease-out);
  }
  :global(.svc:hover) [data-route],
  :global(.svc:hover) [data-line] {
    animation: draw 1.2s var(--ease-out);
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 260;
    }
  }
</style>
