---
/**
 * Interactive "connected supply" view. The ring mirrors the 247CREATIVEHUB logo;
 * each node opens an illustrative lens. All figures are illustrative, not client data.
 */
import Icon from './Icon.astro';

const lenses = [
  { id: 'spend', label: 'Spend', verb: 'See opportunity', pos: 'n', angle: 0 },
  { id: 'supply', label: 'Supply', verb: 'Improve reliability', pos: 'e', angle: 90 },
  { id: 'stock', label: 'Stock', verb: 'Release cash', pos: 's', angle: 180 },
  { id: 'risk', label: 'Risk', verb: 'Protect continuity', pos: 'w', angle: 270 },
] as const;

const spend = [
  { k: 'Raw materials', v: 34 },
  { k: 'Packaging', v: 18 },
  { k: 'Freight', v: 15 },
  { k: 'Facilities', v: 11 },
  { k: 'Services', v: 9 },
  { k: 'Other', v: 13 },
].sort((a, b) => b.v - a.v);
const spendMax = Math.max(...spend.map((d) => d.v));

const otif = [
  { k: 'Supplier A', v: 97 },
  { k: 'Supplier B', v: 93 },
  { k: 'Supplier C', v: 78 },
  { k: 'Supplier D', v: 96 },
  { k: 'Supplier E', v: 86 },
];
const otifTarget = 95;
const otifMin = 60;

const stock = [
  { k: 'Healthy', v: 58, cls: 'a' },
  { k: 'Slow-moving', v: 24, cls: 'b' },
  { k: 'Excess', v: 18, cls: 'c' },
];

// Risk matrix: likelihood (x 1-3) × impact (y 1-3)
const risks = [
  { x: 3, y: 3, k: 'Single-source component' },
  { x: 2, y: 3, k: 'Overseas packaging supplier' },
  { x: 3, y: 2, k: 'Volatile freight lane' },
  { x: 1, y: 3, k: 'Specialist sub-contractor' },
  { x: 2, y: 1, k: 'Office consumables' },
  { x: 1, y: 2, k: 'Secondary raw material' },
  { x: 1, y: 1, k: 'Cleaning services' },
];
const cellRisk = (x: number, y: number) => x + y; // 2..6 → shade step
---

<div class="intel on-dark" data-intel>
  <div class="intel__stage">
    <svg class="intel__svg" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
      <defs>
        <radialGradient id="hubGlow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#34ad57" stop-opacity="0.35"></stop>
          <stop offset="100%" stop-color="#34ad57" stop-opacity="0"></stop>
        </radialGradient>
      </defs>
      <circle cx="200" cy="200" r="190" class="ring-outer"></circle>
      <circle cx="200" cy="200" r="190" class="ring-outer-dash"></circle>
      <circle cx="200" cy="200" r="144" class="ring-main"></circle>
      <g class="ring-arc-wrap">
        <circle cx="200" cy="200" r="144" class="ring-arc" pathLength="100"></circle>
      </g>
      {
        lenses.map((l) => {
          const rad = ((l.angle - 90) * Math.PI) / 180;
          const x2 = 200 + Math.cos(rad) * 144;
          const y2 = 200 + Math.sin(rad) * 144;
          const x1 = 200 + Math.cos(rad) * 58;
          const y1 = 200 + Math.sin(rad) * 58;
          return (
            <g class="spoke" data-spoke={l.id}>
              <line x1={x1} y1={y1} x2={x2} y2={y2} class="spoke__base" />
              <line x1={x1} y1={y1} x2={x2} y2={y2} class="spoke__flow" />
            </g>
          );
        })
      }
      <circle cx="200" cy="200" r="96" fill="url(#hubGlow)"></circle>
      <circle cx="200" cy="200" r="54" class="hub-pulse"></circle>
      <circle cx="200" cy="200" r="54" class="hub"></circle>
      <text x="200" y="203" text-anchor="middle" class="hub__num">247</text>
      <text x="200" y="224" text-anchor="middle" class="hub__label">CONNECTED</text>
    </svg>

    <div class="intel__nodes" role="tablist" aria-label="Supply chain lenses">
      {
        lenses.map((l, i) => (
          <button
            type="button"
            role="tab"
            id={`lens-tab-${l.id}`}
            class={`node node--${l.pos}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`lens-${l.id}`}
            tabindex={i === 0 ? 0 : -1}
            data-lens={l.id}
            data-angle={l.angle}
          >
            <span class="node__dot" aria-hidden="true" />
            <span class="node__text">
              <strong>{l.label}</strong>
              <small>{l.verb}</small>
            </span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="intel__panel">
    <div class="intel__panel-head">
      <span class="fig-note">Connected supply view</span>
      <span class="tag">Illustrative data</span>
    </div>

    <!-- Spend -->
    <section class="lens" id="lens-spend" role="tabpanel" aria-labelledby="lens-tab-spend" data-panel="spend">
      <p class="lens__q">Where is money leaking?</p>
      <div class="hbars" role="img" aria-label="Illustrative spend by category: raw materials 34%, packaging 18%, freight 15%, other 13%, facilities 11%, services 9%. The top three categories hold 67% of spend.">
        {
          spend.map((d, i) => (
            <div class:list={['hbar', { 'is-focus': i < 3 }]}>
              <span class="hbar__k">{d.k}</span>
              <span class="hbar__track">
                <span class="hbar__fill" style={`--w:${(d.v / spendMax) * 100}%`} />
              </span>
              <span class="hbar__v">{d.v}%</span>
            </div>
          ))
        }
      </div>
      <p class="lens__insight"><Icon name="arrow-right" size={15} /> Three categories make up two-thirds of spend. That’s where to look first.</p>
    </section>

    <!-- Supply -->
    <section class="lens" id="lens-supply" role="tabpanel" aria-labelledby="lens-tab-supply" data-panel="supply" hidden>
      <p class="lens__q">Which suppliers are letting you down?</p>
      <div class="hbars hbars--target" style={`--t:${((otifTarget - otifMin) / (100 - otifMin)) * 100}%`} role="img" aria-label={`Illustrative on-time-in-full by supplier against a ${otifTarget}% target. Suppliers C (78%), E (86%) and B (93%) are below target.`}>
        {
          otif.map((d) => (
            <div class:list={['hbar', { 'is-focus': d.v < otifTarget }]}>
              <span class="hbar__k">{d.k}</span>
              <span class="hbar__track">
                <span class="hbar__fill" style={`--w:${((d.v - otifMin) / (100 - otifMin)) * 100}%`} />
              </span>
              <span class="hbar__v">{d.v}%</span>
            </div>
          ))
        }
        <span class="hbars__target-label">Target {otifTarget}%</span>
      </div>
      <p class="lens__insight"><Icon name="arrow-right" size={15} /> A simple OTIF scorecard turns “they’re always late” into evidence.</p>
    </section>

    <!-- Stock -->
    <section class="lens" id="lens-stock" role="tabpanel" aria-labelledby="lens-tab-stock" data-panel="stock" hidden>
      <p class="lens__q">How much cash is sitting on the shelf?</p>
      <div class="segbar" role="img" aria-label="Illustrative inventory value split: healthy 58%, slow-moving 24%, excess 18%.">
        <div class="segbar__bar">
          {stock.map((d) => <span class={`segbar__seg segbar__seg--${d.cls}`} style={`--w:${d.v}%`} />)}
        </div>
        <ul class="segbar__legend" role="list">
          {
            stock.map((d) => (
              <li>
                <i class={`sw sw--${d.cls}`} />
                <span>{d.k}</span>
                <strong>{d.v}%</strong>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="lens__insight"><Icon name="arrow-right" size={15} /> Separating slow-moving and excess stock shows what can be released safely.</p>
    </section>

    <!-- Risk -->
    <section class="lens" id="lens-risk" role="tabpanel" aria-labelledby="lens-tab-risk" data-panel="risk" hidden>
      <p class="lens__q">What would stop you trading tomorrow?</p>
      <div class="matrix-wrap" role="img" aria-label="Illustrative risk matrix plotting seven suppliers and materials by likelihood and impact. A single-source component sits in the highest-risk cell.">
        <span class="matrix__y">Impact</span>
        <div class="matrix">
          {
            [3, 2, 1].map((y) =>
              [1, 2, 3].map((x) => (
                <div class="matrix__cell" style={`--s:${cellRisk(x, y)}`}>
                  {risks
                    .filter((r) => r.x === x && r.y === y)
                    .map((r) => (
                      <span class:list={['matrix__dot', { 'is-focus': x + y >= 5 }]} title={r.k} />
                    ))}
                </div>
              )),
            )
          }
        </div>
        <span class="matrix__x">Likelihood</span>
      </div>
      <p class="lens__insight"><Icon name="arrow-right" size={15} /> Plotting suppliers by likelihood and impact turns worry into a priority list.</p>
    </section>
  </div>
</div>

<style>
  .intel {
    position: relative;
    width: 100%;
    max-width: 540px;
    margin-inline: auto;
  }

  /* ---- Ring stage ---- */
  .intel {
    perspective: 1100px;
  }
  .intel__stage {
    position: relative;
    transform-style: preserve-3d;
    will-change: transform;
    transition: transform 0.9s var(--ease-out);
    aspect-ratio: 1;
    width: 100%;
    max-width: 420px;
    margin-inline: auto;
  }
  .intel__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .ring-outer {
    fill: none;
    stroke: rgb(255 255 255 / 0.06);
  }
  .ring-outer-dash {
    fill: none;
    stroke: rgb(255 255 255 / 0.22);
    stroke-width: 1;
    stroke-dasharray: 2 10;
    transform-origin: 200px 200px;
    animation: spin 90s linear infinite;
  }
  .ring-main {
    fill: none;
    stroke: rgb(255 255 255 / 0.14);
    stroke-width: 1.5;
  }
  .ring-arc-wrap {
    transform-origin: 200px 200px;
    transform: rotate(calc(var(--angle, 0) * 1deg));
    transition: transform 1.1s var(--ease-in-out);
  }
  .ring-arc {
    fill: none;
    stroke: var(--green-400);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 14 86;
    /* centre the 14-unit arc on 12 o'clock */
    stroke-dashoffset: 32;
    filter: drop-shadow(0 0 6px rgb(92 199 122 / 0.6));
  }
  .spoke__base {
    stroke: rgb(255 255 255 / 0.1);
    stroke-width: 1;
  }
  .spoke__flow {
    stroke: var(--green-400);
    stroke-width: 1.5;
    stroke-dasharray: 3 9;
    opacity: 0;
    transition: opacity 0.5s;
    animation: flow 1.4s linear infinite;
  }
  .spoke.is-active .spoke__flow {
    opacity: 1;
  }
  .hub {
    fill: var(--navy-800);
    stroke: rgb(255 255 255 / 0.2);
  }
  .hub-pulse {
    fill: none;
    stroke: var(--green-400);
    transform-origin: 200px 200px;
    animation: pulse 3.2s var(--ease-out) infinite;
  }
  .hub__num {
    fill: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 26px;
    letter-spacing: -0.04em;
  }
  .hub__label {
    fill: var(--on-dark-3);
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: 0.2em;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -24;
    }
  }
  @keyframes pulse {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    100% {
      transform: scale(1.75);
      opacity: 0;
    }
  }

  /* ---- Nodes ---- */
  .node {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.85rem 0.4rem 0.4rem;
    border-radius: 999px;
    border: 1px solid var(--line-dark-strong);
    background: rgb(6 35 95 / 0.85);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: #fff;
    text-align: left;
    transform: translate(-50%, -50%);
    transition:
      border-color 0.3s,
      background-color 0.3s,
      box-shadow 0.3s;
    white-space: nowrap;
  }
  .node:hover {
    border-color: rgb(255 255 255 / 0.4);
  }
  .node[aria-selected='true'] {
    background: var(--paper);
    color: var(--navy-900);
    border-color: var(--paper);
    box-shadow: 0 10px 30px -8px rgb(0 0 0 / 0.5);
  }
  .node--n {
    left: 50%;
    top: 14%;
  }
  .node--e {
    left: 86%;
    top: 50%;
  }
  .node--s {
    left: 50%;
    top: 86%;
  }
  .node--w {
    left: 14%;
    top: 50%;
  }
  .node__dot {
    position: relative;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: var(--navy-700);
    border: 1px solid var(--line-dark-strong);
    flex: none;
  }
  .node__dot::after {
    content: '';
    position: absolute;
    inset: 8px;
    border-radius: 999px;
    background: var(--yellow);
    transition: transform 0.3s var(--ease-out);
  }
  .node[aria-selected='true'] .node__dot {
    background: var(--navy-800);
    border-color: var(--navy-800);
  }
  .node[aria-selected='true'] .node__dot::after {
    background: var(--green-400);
    transform: scale(1.15);
  }
  .node__text strong {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.1;
  }
  .node__text small {
    display: block;
    font-size: 0.7rem;
    color: var(--on-dark-3);
    line-height: 1.2;
  }
  .node[aria-selected='true'] .node__text small {
    color: var(--muted);
  }
  @media (max-width: 420px) {
    .node__text small {
      display: none;
    }
    .node {
      padding-right: 0.7rem;
    }
  }

  /* ---- Panel ---- */
  .intel__panel {
    position: relative;
    margin-top: -1.5rem;
    padding: 1.25rem 1.35rem 1.35rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.075), rgb(255 255 255 / 0.035));
    border: 1px solid var(--line-dark-strong);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.6);
    min-height: 262px;
  }
  .intel__panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .lens {
    animation: lensIn 0.55s var(--ease-out) both;
  }
  .lens[hidden] {
    display: none;
  }
  .lens__q {
    font-size: 1.12rem;
    font-weight: 560;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  .lens__insight {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line-dark);
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--on-dark-2);
  }
  .lens__insight :global(.icon) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--green-400);
  }
  @keyframes lensIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  /* Horizontal bars */
  .hbars {
    position: relative;
    display: grid;
    gap: 0.45rem;
  }
  .hbar {
    display: grid;
    grid-template-columns: 6.6rem 1fr 2.6rem;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.78rem;
  }
  .hbar__k {
    color: var(--on-dark-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hbar__v {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--on-dark-3);
    text-align: right;
  }
  .hbar.is-focus .hbar__v,
  .hbar.is-focus .hbar__k {
    color: #fff;
  }
  .hbar__track {
    position: relative;
    height: 10px;
  }
  .hbar__fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--w);
    border-radius: 0 4px 4px 0;
    background: rgb(159 179 216 / 0.38);
    transform-origin: left;
    animation: grow 0.9s var(--ease-out) both;
  }
  .hbar.is-focus .hbar__fill {
    background: var(--green-400);
  }
  .hbars--target .hbar.is-focus .hbar__fill {
    background: var(--yellow);
  }
  /* target rule: one tick per row, joined across the row gaps */
  .hbars--target .hbar__track::after {
    content: '';
    position: absolute;
    top: -7px;
    bottom: -7px;
    left: var(--t);
    width: 1px;
    background: rgb(255 255 255 / 0.6);
  }
  .hbars__target-label {
    justify-self: end;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-dark-3);
  }
  @keyframes grow {
    from {
      transform: scaleX(0);
    }
  }

  /* Segmented bar */
  .segbar__bar {
    display: flex;
    gap: 2px;
    height: 46px;
    border-radius: 6px;
    overflow: hidden;
  }
  .segbar__seg {
    width: var(--w);
    transform-origin: left;
    animation: grow 0.9s var(--ease-out) both;
  }
  .segbar__seg--a,
  .sw--a {
    background: rgb(159 179 216 / 0.38);
  }
  .segbar__seg--b,
  .sw--b {
    background: var(--green-400);
  }
  .segbar__seg--c,
  .sw--c {
    background: var(--yellow);
  }
  .segbar__legend {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 0.5rem 1.4rem;
    margin-top: 0.9rem;
    font-size: 0.8rem;
    color: var(--on-dark-2);
  }
  .segbar__legend li {
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    column-gap: 0.45rem;
  }
  .segbar__legend strong {
    grid-column: 2;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 1.15rem;
    color: #fff;
  }
  .sw {
    width: 10px;
    height: 10px;
    border-radius: 3px;
  }

  /* Risk matrix */
  .matrix-wrap {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    gap: 0.4rem 0.6rem;
  }
  .matrix__y {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    text-align: center;
  }
  .matrix__x {
    grid-column: 2;
    text-align: center;
  }
  .matrix__x,
  .matrix__y {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-dark-3);
  }
  .matrix {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
  }
  .matrix__cell {
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    justify-content: center;
    gap: 5px;
    height: 34px;
    border-radius: 4px;
    /* one hue, light → dark as risk rises */
    background: rgb(159 179 216 / calc((var(--s) - 1) * 0.06));
  }
  .matrix__dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--navy-200);
    box-shadow: 0 0 0 2px var(--navy-900);
    animation: pop 0.5s var(--ease-out) both;
  }
  .matrix__dot.is-focus {
    background: var(--yellow);
  }
  @keyframes pop {
    from {
      transform: scale(0);
    }
  }
</style>
