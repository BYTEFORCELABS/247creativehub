# Production domain, used for canonical URLs, Open Graph tags and sitemap.xml
SITE_URL=https://www.example.co.uk

# Enquiry form endpoint. Any service that accepts a JSON POST and returns 2xx works.
# Formspree example: create a form at https://formspree.io and paste its endpoint here.
# Leave empty and the form opens the visitor's email app with the enquiry pre-filled instead.
PUBLIC_FORM_ENDPOINT=
